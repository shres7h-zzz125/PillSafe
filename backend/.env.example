# PillSafe Backend Configuration
# Copy this file to .env and fill in any credentials you have obtained.
# NEVER commit .env to Git.

APP_NAME=PillSafe API
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Local SQLite cache (API response cache + user confirmed medicine list)
CACHE_DB_PATH=data/cache.db
CACHE_TTL_SECONDS=43200

# NLM RxNorm / RxNav REST API (public, no API key required)
RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST
HTTP_TIMEOUT_SECONDS=10.0

# openFDA Drug Label API (public; optional free API key increases daily quota from 1,000 to 120,000)
OPENFDA_BASE_URL=https://api.fda.gov/drug/label.json
OPENFDA_API_KEY=

# NRCeS Common Drug Codes for India (CDCI) Flat Files directory
# Download official TSV files after registering at https://www.nrces.in/
CDCI_DATA_DIR=data/cdci

# ABDM Drug Registry (requires ABDM Sandbox registration & approval at https://sandbox.abdm.gov.in)
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_GATEWAY_URL=https://dev.abdm.gov.in/gateway/v0.5/sessions
ABDM_DRUG_REGISTRY_URL=https://drugregistrysbx.abdm.gov.in/dr/v3

# DrugBank API (requires paid commercial license or approved academic access at https://www.drugbank.com)
# Until configured, drug-drug interaction checks strictly return grey "Could not check".
DRUGBANK_API_KEY=
DRUGBANK_BASE_URL=https://api.drugbank.com/v1
